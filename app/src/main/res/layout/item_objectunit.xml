<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginTop="8dp"
    android:layout_marginEnd="16dp"
    android:layout_marginBottom="4dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="6dp"
    app:cardBackgroundColor="@color/cardBackgroundColor">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Адрес (заголовок) -->
        <TextView
            android:id="@+id/textAddress"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Адрес"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/cardHeaderColor"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Разделитель -->
        <View
            android:id="@+id/divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#40FFFFFF"
            android:layout_marginVertical="8dp"
            app:layout_constraintTop_toBottomOf="@id/textAddress" />

        <!-- Тип юнита -->
        <TextView
            android:id="@+id/labelTypeUnit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Тип:"
            android:textSize="14sp"
            android:textColor="@color/cardSecondaryTextColor"
            app:layout_constraintTop_toBottomOf="@id/divider"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/textTypeUnit"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Лифт"
            android:textSize="16sp"
            android:textColor="@color/cardMainTextColor"
            android:layout_marginStart="8dp"
            app:layout_constraintTop_toTopOf="@id/labelTypeUnit"
            app:layout_constraintStart_toEndOf="@id/labelTypeUnit"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Тип объекта и Этажность -->
        <TextView
            android:id="@+id/labelTypeObject"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Объект:"
            android:textSize="14sp"
            android:textColor="@color/cardSecondaryTextColor"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/labelTypeUnit"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/textTypeObject"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Грузопассажирский"
            android:textSize="16sp"
            android:textColor="@color/cardMainTextColor"
            android:layout_marginStart="8dp"
            app:layout_constraintTop_toTopOf="@id/labelTypeObject"
            app:layout_constraintStart_toEndOf="@id/labelTypeObject"
            app:layout_constraintEnd_toStartOf="@id/labelFloors" />

        <TextView
            android:id="@+id/labelFloors"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Этажей:"
            android:textSize="14sp"
            android:textColor="@color/cardSecondaryTextColor"
            app:layout_constraintTop_toTopOf="@id/labelTypeObject"
            app:layout_constraintStart_toEndOf="@id/textTypeObject"
            android:layout_marginStart="8dp" />

        <TextView
            android:id="@+id/textFloors"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="5"
            android:textSize="16sp"
            android:textColor="@color/cardMainTextColor"
            android:layout_marginStart="4dp"
            app:layout_constraintTop_toTopOf="@id/labelFloors"
            app:layout_constraintStart_toEndOf="@id/labelFloors"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Парковка -->
        <TextView
            android:id="@+id/labelParking"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Парковка:"
            android:textSize="14sp"
            android:textColor="@color/cardSecondaryTextColor"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/labelTypeObject"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/textParking"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Есть"
            android:textSize="16sp"
            android:textColor="@color/cardMainTextColor"
            android:layout_marginStart="8dp"
            app:layout_constraintTop_toTopOf="@id/labelParking"
            app:layout_constraintStart_toEndOf="@id/labelParking" />

        <!-- Кнопки действий -->
        <LinearLayout
            android:id="@+id/actionButtonsLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/labelParking">

            <Button
                android:id="@+id/btnEdit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Изменить"
                style="@style/Widget.AppCompat.Button.Borderless"
                android:textColor="@color/colorPrimary"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnDelete"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Удалить"
                style="@style/Widget.AppCompat.Button.Borderless"
                android:textColor="@android:color/holo_red_dark"
                android:textSize="14sp"
                android:layout_marginStart="16dp" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>