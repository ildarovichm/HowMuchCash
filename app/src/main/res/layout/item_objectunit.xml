<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="4dp"
    style="@style/MyObjectUnitCardStyle">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Адрес (самая важная информация - сверху) -->
        <TextView
            android:id="@+id/textAddress"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Адрес"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/cardHeaderColor"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Разделитель -->
        <View
            android:id="@+id/divider1"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            app:layout_constraintTop_toBottomOf="@+id/textAddress" />

        <!-- Первая строка таблицы: Тип юнита и Количество объектов УДАЛЕНО -->
        <TextView
            android:id="@+id/labelTypeUnit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Тип юнита:"
            android:textSize="14sp"
            android:textColor="@android:color/darker_gray"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/divider1" />

        <TextView
            android:id="@+id/textTypeUnit"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Тип юнита"
            android:textSize="16sp"
            android:textColor="@color/cardMainTextColor"
            android:layout_marginStart="8dp"
            app:layout_constraintStart_toEndOf="@+id/labelTypeUnit"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/labelTypeUnit"
            app:layout_constraintBottom_toBottomOf="@+id/labelTypeUnit" />

        <!-- Вторая строка: Тип объекта и Этажность -->
        <TextView
            android:id="@+id/labelTypeObject"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Тип объекта:"
            android:textSize="14sp"
            android:textColor="@android:color/darker_gray"
            android:layout_marginTop="8dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/labelTypeUnit" />

        <TextView
            android:id="@+id/textTypeObject"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Тип объекта"
            android:textColor="@color/cardMainTextColor"
            android:textSize="16sp"
            android:layout_marginStart="8dp"
            app:layout_constraintStart_toEndOf="@+id/labelTypeObject"
            app:layout_constraintEnd_toStartOf="@+id/labelFloors"
            app:layout_constraintTop_toTopOf="@+id/labelTypeObject"
            app:layout_constraintBottom_toBottomOf="@+id/labelTypeObject" />

        <TextView
            android:id="@+id/labelFloors"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Этажей:"
            android:textSize="14sp"
            android:textColor="@android:color/darker_gray"
            app:layout_constraintStart_toEndOf="@+id/textTypeObject"
            app:layout_constraintTop_toTopOf="@+id/labelTypeObject"
            android:layout_marginStart="8dp" />

        <TextView
            android:id="@+id/textFloors"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="@color/cardMainTextColor"
            android:textSize="16sp"
            android:layout_marginStart="4dp"
            app:layout_constraintStart_toEndOf="@+id/labelFloors"
            app:layout_constraintTop_toTopOf="@+id/labelTypeObject"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Третья строка: Парковка -->
        <TextView
            android:id="@+id/labelParking"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Парковка:"
            android:textSize="14sp"
            android:textColor="@android:color/darker_gray"
            android:layout_marginTop="8dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/labelTypeObject" />

        <TextView
            android:id="@+id/textParking"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Нет"
            android:textColor="@color/cardMainTextColor"
            android:textSize="16sp"
            android:layout_marginStart="8dp"
            app:layout_constraintStart_toEndOf="@+id/labelParking"
            app:layout_constraintTop_toTopOf="@+id/labelParking"
            app:layout_constraintBottom_toBottomOf="@+id/labelParking" />

        <!-- Четвертая строка: Только TO (DEL удален) -->
        <LinearLayout
            android:id="@+id/checkBoxesLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@+id/labelParking">

            <TextView
                android:id="@+id/labelToCheckBox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TO:"
                android:textSize="14sp"
                android:textColor="@android:color/darker_gray" />

            <TextView
                android:id="@+id/textToCheckBox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Нет"
                android:textColor="@color/cardMainTextColor"
                android:textSize="16sp"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <!-- Кнопки действий -->
        <LinearLayout
            android:id="@+id/actionButtonsLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp"
            android:gravity="end"
            app:layout_constraintTop_toBottomOf="@+id/checkBoxesLayout">

            <Button
                android:id="@+id/btnEdit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Редактировать"
                android:textSize="10sp"
                style="@style/Widget.AppCompat.Button.Borderless"
                android:textColor="@android:color/holo_blue_dark" />

            <Button
                android:id="@+id/btnDelete"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Удалить"
                android:textSize="10sp"
                style="@style/Widget.AppCompat.Button.Borderless"
                android:textColor="@android:color/holo_red_dark"
                android:layout_marginStart="8dp" />

            <Button
                android:id="@+id/btnDetails"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Еще"
                android:textSize="10sp"
                style="@style/Widget.AppCompat.Button.Borderless"
                android:textColor="#FDCA1B"
                android:layout_marginStart="8dp" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>