<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="8dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Адрес (только для чтения) -->
        <TextView
            android:id="@+id/textAddress"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Адрес"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/cardHeaderColor"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/divider1"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            app:layout_constraintTop_toBottomOf="@+id/textAddress" />

        <!-- Тип юнита -->
        <TextView
            android:id="@+id/labelTypeUnit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Тип юнита:"
            android:textSize="14sp"
            android:textColor="@android:color/darker_gray"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/divider1" />

        <Spinner
            android:id="@+id/spinnerTypeUnit"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            app:layout_constraintStart_toEndOf="@+id/labelTypeUnit"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/labelTypeUnit" />

        <!-- Тип объекта и Этажность -->
        <TextView
            android:id="@+id/labelTypeObject"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Тип объекта:"
            android:textSize="14sp"
            android:textColor="@android:color/darker_gray"
            android:layout_marginTop="8dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/labelTypeUnit" />

        <Spinner
            android:id="@+id/spinnerTypeObject"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            app:layout_constraintStart_toEndOf="@+id/labelTypeObject"
            app:layout_constraintEnd_toStartOf="@+id/labelFloors"
            app:layout_constraintTop_toTopOf="@+id/labelTypeObject" />

        <TextView
            android:id="@+id/labelFloors"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Этажей:"
            android:textSize="14sp"
            android:textColor="@android:color/darker_gray"
            app:layout_constraintStart_toEndOf="@+id/spinnerTypeObject"
            app:layout_constraintTop_toTopOf="@+id/labelTypeObject"
            android:layout_marginStart="8dp" />

        <EditText
            android:id="@+id/editFloors"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="@color/cardMainTextColor"
            android:textSize="16sp"
            android:inputType="number"
            android:layout_marginStart="4dp"
            android:background="@null"
            app:layout_constraintStart_toEndOf="@+id/labelFloors"
            app:layout_constraintTop_toTopOf="@+id/labelTypeObject"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Парковка -->
        <TextView
            android:id="@+id/labelParking"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Парковка:"
            android:textSize="14sp"
            android:textColor="@android:color/darker_gray"
            android:layout_marginTop="8dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/labelTypeObject" />

        <Spinner
            android:id="@+id/spinnerParking"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            app:layout_constraintStart_toEndOf="@+id/labelParking"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/labelParking" />

        <!-- TO CheckBox -->
        <TextView
            android:id="@+id/labelToCheckBox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ТО:"
            android:textSize="14sp"
            android:textColor="@android:color/darker_gray"
            android:layout_marginTop="8dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/labelParking" />

        <CheckBox
            android:id="@+id/checkBoxTO"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:layout_marginStart="8dp"
            app:layout_constraintStart_toEndOf="@+id/labelToCheckBox"
            app:layout_constraintTop_toTopOf="@+id/labelToCheckBox" />

        <!-- Кнопки: Save и Delete с отступом между ними -->
        <Button
            android:id="@+id/btnDelete"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Удалить"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:textColor="@android:color/holo_red_dark"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/checkBoxTO"
            android:layout_marginTop="16dp"
            android:layout_marginStart="8dp" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Сохранить"
            style="@style/Widget.AppCompat.Button.Borderless.Colored"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/checkBoxTO"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="8dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>