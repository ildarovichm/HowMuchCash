<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.slideshow.SlideshowFragment">

    <TableLayout
        android:id="@+id/tableLayout2"
        android:layout_width="389dp"
        android:layout_height="174dp"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1.0">

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:visibility="visible">

            <TextView
                android:id="@+id/textViewSalaryLiftHeaderTR"
                android:layout_width="190dp"
                android:layout_height="match_parent"
                android:background="#005B00"
                android:text="ЗП за лифты: "
                android:textColor="#FFFFFF" />

            <TextView
                android:id="@+id/textViewSalaryLiftTR"
                android:layout_width="190dp"
                android:layout_height="wrap_content"
                android:background="#005B00"
                android:text=""
                android:textColor="#FFFFFF" />
        </TableRow>

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp">

            <TextView
                android:id="@+id/textViewSalaryElevatorHeaderTR"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#005B00"
                android:text="ЗП за подъемники: "
                android:textColor="#FFFFFF" />

            <TextView
                android:id="@+id/textViewSalaryElevatorTR"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#005B00"
                android:text=""
                android:textColor="#FFFFFF" />
        </TableRow>

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp">

            <TextView
                android:id="@+id/textViewSalaryAmountObjectsHeaderTR"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#005B00"
                android:text="ЗП за объем: "
                android:textColor="#FFFFFF" />

            <TextView
                android:id="@+id/textViewSalaryAmountObjectsTR"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#005B00"
                android:text=""
                android:textColor="#FFFFFF" />
        </TableRow>

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp">

            <TextView
                android:id="@+id/textViewSalaryWatchHeaderTR"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#005B00"
                android:text="ЗП за дежурства: "
                android:textColor="#FFFFFF" />

            <TextView
                android:id="@+id/textViewSalaryWatchTR"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#005B00"
                android:text=""
                android:textColor="#FFFFFF" />
        </TableRow>

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp">

            <TextView
                android:id="@+id/textViewSalaryAmountAllHeaderTR"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#005B00"
                android:text="ЗП общая: "
                android:textColor="#FFFFFF" />

            <TextView
                android:id="@+id/textViewSalaryAmountAllTR"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#005B00"
                android:text=""
                android:textColor="#FFFFFF" />
        </TableRow>
    </TableLayout>

</androidx.constraintlayout.widget.ConstraintLayout>